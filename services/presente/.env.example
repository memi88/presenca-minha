# Copie para .env em desenvolvimento local. Nunca commitar o .env real
# (ja esta no .gitignore). Em produção (Railway), estas mesmas chaves vao
# em Project -> Variables -- não em arquivo.

# Postgres local (docker compose up -d) ou, em produção, injetado
# automaticamente pelo plugin Postgres do Railway (${{Postgres.DATABASE_URL}}).
# Aceita postgres://, postgresql:// ou postgresql+psycopg:// -- normalizado
# em app/config.py.
DATABASE_URL=postgresql+psycopg://presente:presente_dev_local@localhost:5433/presente

# Senha compartilhada do laboratório (IMPLEMENTATION_PLAN.md secao 1.2).
# Escolha algo não-trivial -- é a única barreira de acesso à URL pública.
APP_PASSWORD=troque-esta-senha

# Chave de assinatura do cookie de sessão. Gere uma própria, ex.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=troque-este-segredo

# Opcional. So necessaria pra usar GPT56SolClient de verdade (A5,
# app/alpha/modelo_gpt56sol.py) -- sem ela o app sobe normalmente, so o
# Interpretation Engine real fica indisponivel (os testes usam um cliente
# simulado, nao precisam desta chave). Deixe vazia/comentada ate a chave
# de producao ser criada de proposito para este projeto.
# OPENAI_API_KEY=
