# Copie para .env.local e preencha com os valores do dashboard do Supabase
# (Project Settings > API). Só a URL e a chave anon/publishable — nunca a
# service_role. service_role não tem lugar em nenhum código de frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — Site Key (pública, segura de expor). A Secret Key
# NÃO entra aqui: vai só no dashboard do Supabase (Authentication > Attack
# Protection). Sem essa variável, o login anônimo funciona sem captcha
# (fallback de dev local).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Microsserviço de IA (services/ia) — embeddings e, no futuro, Human Design.
# SEM prefixo NEXT_PUBLIC_: só server-side (Server Actions), nunca chega no
# bundle do browser. IA_SERVICE_API_KEY precisa ter o mesmo valor configurado
# no ambiente do serviço (ver services/ia/.env.example).
IA_SERVICE_URL=
IA_SERVICE_API_KEY=

# API Anthropic — conversa (Claude Sonnet 5) e, no futuro, microcopy (Haiku
# 4.5). SEM prefixo NEXT_PUBLIC_: só server-side (lib/anthropic.ts), nunca
# chega no bundle do browser. Gere em https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# Motor Presente (repositório separado, Railway) — lente do dia na Home e
# na Conversa (lib/present.ts). SEM prefixo NEXT_PUBLIC_: só server-side.
# Endpoint genérico não exige autenticação — sem essa variável, a lente
# some silenciosamente (fail-open).
PRESENTE_SERVICE_URL=

# Better Auth (migração Supabase→Cloudflare, lib/auth.ts) — mesmo valor
# tem que estar configurado nos dois apps (Presença e Cuida), já que
# compartilham o mesmo D1. Gere um valor aleatório (ex:
# `openssl rand -base64 32`) — nunca reaproveite entre ambientes
# diferentes (dev/produção).
BETTER_AUTH_SECRET=

# OAuth do Google (Continuar com o Google) — criar em
# https://console.cloud.google.com/apis/credentials, tipo "Web
# application", com o redirect URI
# `<seu domínio>/api/auth/callback/google`. Sem essas duas variáveis,
# login por e-mail/senha e sessão anônima continuam funcionando — só o
# botão do Google fica indisponível (Better Auth já degrada sozinho,
# só loga um aviso).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
