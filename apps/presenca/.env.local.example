# Copie para .env.local e preencha com os valores do dashboard do Supabase
# (Project Settings > API). Só a URL e a chave anon/publishable — nunca a
# service_role. service_role não tem lugar em nenhum código de frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — Site Key (pública, segura de expor). A Secret Key
# NÃO entra aqui: vai só no dashboard do Supabase (Authentication > Attack
# Protection). Sem essa variável, o login anônimo funciona sem captcha
# (fallback de dev local).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
